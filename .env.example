# Copy this file to .env and fill in local values.
# Never commit a real .env file or paste API keys into source code or screenshots.

# Optional LLM. Required for translated Hindi/Telugu chatbot explanations.
# Without a key the app starts offline; UI labels translate, but legal passages
# remain in their original language and the assistant will say translation is unavailable.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=45

# Optional embedding model (downloaded on first use when enabled; can delay startup)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
NYAYA_USE_EMBEDDINGS=0

# Set an administrator username and password here for local development.
# Public deployment: configure a unique password in the host's private environment/secrets.
ADMIN_USERNAME=NyayaMitra
ADMIN_PASSWORD=

# Public deployment privacy mode disables persistent chat/search/quiz-answer history.
NYAYA_PUBLIC_MODE=0

# Optional persistent data locations (Render Blueprint sets these automatically).
# NYAYA_DATA_DIR=
# NYAYA_DB_PATH=
# NYAYA_UPLOADS_DIR=

# Upload limit (20 MB)
MAX_UPLOAD_BYTES=20971520
